<?php

/**
 * Theme hooks for the SCS Custom Theme.
 */

/**
 * Whether this is an imprint/privacy/accessibility page viewed while logged in.
 *
 * Logged-in users get the dashboard layout there; visitors keep the public one.
 */
function scs_custom_theme_is_legal_page_for_member(string $request_path): bool {
  return \Drupal::currentUser()->isAuthenticated()
    && preg_match('#/(imprint|privacy-policy|accessibility|terms-of-service)/?$#', $request_path) === 1;
}

/**
 * Implements hook_preprocess_page().
 */
function scs_custom_theme_preprocess_page(array &$variables): void {
  $path = trim((string) ($variables['root_path'] ?? ''), '/');
  $request_path = (string) parse_url($_SERVER['REQUEST_URI'] ?? '', PHP_URL_PATH);
  $is_manager_page = str_contains($path, 'soda-scs-manager')
    || str_contains($request_path, '/soda-scs-manager')
    || scs_custom_theme_is_legal_page_for_member($request_path);
  $variables['is_manager_page'] = $is_manager_page;

  $variables['user_picture'] = [];
  $variables['user_initials'] = '';
  $variables['user_name'] = '';
  $variables['user_email'] = '';
  $variables['dashboard_projects'] = [];
  $account = \Drupal::currentUser();
  if ($is_manager_page && $account->isAuthenticated()) {
    $user = \Drupal::entityTypeManager()->getStorage('user')->load($account->id());
    if ($user && $user->hasField('user_picture') && !$user->get('user_picture')->isEmpty()) {
      $variables['user_picture'] = $user->get('user_picture')->view([
        'label' => 'hidden',
      ]);
    }
    if ($user && $user->hasField('mail')) {
      $variables['user_email'] = (string) $user->get('mail')->value;
    }
      $first_name = $user->hasField('first_name') ? trim((string) $user->get('first_name')->value) : '';
      $last_name = $user->hasField('last_name') ? trim((string) $user->get('last_name')->value) : '';
      $name = trim($first_name . ' ' . $last_name);
      $variables['user_name'] = $name;
      if ($name === '') {
        $name = (string) $user->getDisplayName();
      }

      $initials = '';
      if ($first_name !== '') {
        $initials .= mb_substr($first_name, 0, 1);
      }
      if ($last_name !== '') {
        $initials .= mb_substr($last_name, 0, 1);
      }
      if ($initials === '') {
        $initials = mb_substr($name, 0, 1);
      }
      $variables['user_initials'] = mb_strtoupper($initials);
    }

    $project_query = \Drupal::entityTypeManager()
      ->getStorage('soda_scs_project')
      ->getQuery()
      ->accessCheck(TRUE)
      ->sort('label', 'ASC');

    if (!$account->hasPermission('soda scs manager admin')) {
      $project_query->condition(
        $project_query->orConditionGroup()
          ->condition('owner', $account->id())
          ->condition('members', $account->id())
      );
    }

    $projects = \Drupal::entityTypeManager()
      ->getStorage('soda_scs_project')
      ->loadMultiple($project_query->execute());

    foreach ($projects as $project) {
      $label = (string) $project->label();
      $variables['dashboard_projects'][] = [
        'acronym' => mb_strtoupper(mb_substr($label, 0, 1)),
        'label' => $label,
        'url' => $project->toUrl('canonical')->toString(),
      ];
    }

  if ($is_manager_page) {
    $variables['theme_hook_suggestions'][] = 'page__dashboard';
    return;
  }

  if ($variables['is_front'] || in_array($path, ['user/login', 'user/register'], TRUE)) {
    $variables['theme_hook_suggestions'][] = 'page__public';
  }
}

/**
 * Implements hook_preprocess_block__system_branding_block().
 */
function scs_custom_theme_preprocess_block__system_branding_block(array &$variables): void {
  $block = \Drupal::entityTypeManager()->getStorage('block')->load($variables['elements']['#id'] ?? '');
  if ($block && $block->getRegion() === 'sidebar_logo') {
    $variables['home_url'] = \Drupal\Core\Url::fromRoute('soda_scs_manager.dashboard')->toString();
  }
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function scs_custom_theme_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  $path = trim((string) ($variables['root_path'] ?? ''), '/');
  $request_path = (string) parse_url($_SERVER['REQUEST_URI'] ?? '', PHP_URL_PATH);

  if (str_contains($path, 'soda-scs-manager') || str_contains($request_path, '/soda-scs-manager') || scs_custom_theme_is_legal_page_for_member($request_path)) {
    $suggestions = array_values(array_diff($suggestions, ['page__public']));
    $suggestions[] = 'page__dashboard';
  }
}

/**
 * Implements hook_theme().
 */
function scs_custom_theme_theme($existing, $type, $theme, $path): array {
  return [
    'scs_custom_theme_wsod' => [
      'variables' => [
        'error_message' => NULL,
      ],
      'template' => 'scs-custom-theme-wsod',
    ],
  ];
}

/**
 * Prepares project member profile pictures for project cards.
 */
function scs_custom_theme_preprocess_soda_scs_manager__project_card(array &$variables): void {
  $variables['member_profiles'] = [];
  $user_storage = \Drupal::entityTypeManager()->getStorage('user');
  $member_ids = array_map('intval', $variables['members_ids'] ?? []);
  $owner_id = (int) ($variables['owner_id'] ?? ($member_ids[0] ?? 0));

  if ($owner_id > 0) {
    $member_ids = array_values(array_unique(array_merge([$owner_id], $member_ids)));
  }

  foreach ($member_ids as $member_id) {
    $user = $user_storage->load($member_id);
    if (!$user) {
      continue;
    }

    $first_name = $user->hasField('first_name') ? trim((string) $user->get('first_name')->value) : '';
    $last_name = $user->hasField('last_name') ? trim((string) $user->get('last_name')->value) : '';
    $name = trim($first_name . ' ' . $last_name);
    if ($name === '') {
      $name = (string) $user->getDisplayName();
    }

    $initials = '';
    if ($first_name !== '') {
      $initials .= mb_substr($first_name, 0, 1);
    }
    if ($last_name !== '') {
      $initials .= mb_substr($last_name, 0, 1);
    }
    if ($initials === '') {
      $initials = mb_substr($name, 0, 1);
    }

    $profile = [
      'name' => $name,
      'initials' => mb_strtoupper($initials),
      'is_owner' => $member_id === $owner_id,
      'picture' => [],
    ];

    if ($user->hasField('user_picture') && !$user->get('user_picture')->isEmpty()) {
      $profile['picture'] = $user->get('user_picture')->view(['label' => 'hidden']);
    }

    $variables['member_profiles'][] = $profile;
  }

  usort($variables['member_profiles'], static function (array $a, array $b): int {
    return (int) $b['is_owner'] <=> (int) $a['is_owner'];
  });
}

/**
 * Supplies the theme asset directory to the module's entity card template.
 */
function scs_custom_theme_preprocess_soda_scs_manager__entity_card(array &$variables): void {
  $variables['directory'] = base_path() . \Drupal::service('extension.list.theme')->getPath('scs_custom_theme');
}
