{# Authenticated SCS Manager dashboard, separate from Drupal administration. #}
<div class="dashboard-layout">
	<aside class="dashboard-sidebar" role="complementary">
		<div class="dashboard-sidebar__logo">
			{{ page.sidebar_logo }}
		</div>
		<div class="dashboard-sidebar__dark">
			<div class="dashboard-sidebar__projects">
				<div class="dashboard-sidebar__projects-header">
					<p class="dashboard-sidebar__projects-title">{{ 'Projects'|t }}</p>
					<button type="button" class="dashboard-sidebar__projects-header-icon soda-scs-manager--create-project-trigger" aria-controls="create-project-wizard" aria-expanded="false" aria-label="{{ 'Create project'|t }}" title="{{ 'Create project'|t }}">
						<svg width="12" height="12" viewbox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
							<line x1="6" y1="-4.37114e-08" x2="6" y2="12" stroke="#17212B" stroke-width="2"/>
							<line x1="12" y1="6" y2="6" stroke="#17212B" stroke-width="2"/>
						</svg>
					</button>
				</div>
				<nav class="dashboard-sidebar__projectnav" aria-label="{{ 'Project navigation'|t }}">
					<ul class="dashboard-sidebar__project-list">
						{% for project in dashboard_projects %}
							<li class="dashboard-sidebar__project-item">
								<a class="dashboard-sidebar__project-link" href="{{ project.url }}">
									<span class="dashboard-sidebar__project-acronym" aria-hidden="true">{{ project.acronym }}</span>
									<span class="dashboard-sidebar__project-name">{{ project.label }}</span>
								</a>
							</li>
						{% else %}
							<li class="dashboard-sidebar__project-item dashboard-sidebar__project-item--empty">
								{{ 'No projects available'|t }}
							</li>
						{% endfor %}
					</ul>
					<a class="dashboard-sidebar__projects-see-all" href="{{ path('soda_scs_manager.dashboard') }}">
						{{ 'See all'|t }}
					</a>
				</nav>
			</div>
			<nav class="dashboard-sidebar__secondary-nav" aria-label="{{ 'Secondary navigation'|t }}">
				{{ page.sidebar_secondary_nav }}
			</nav>
		</div>
		<div class="dashboard-sidebar__account-menu">
			<button type="button" class="dashboard-sidebar__account-menu-header" aria-controls="dashboard-account-menu-content" aria-expanded="false">

				{% if user_picture %}
					<div class="dashboard-sidebar__account-menu-picture" aria-hidden="true">
						{{ user_picture }}
					</div>
				{% else %}
					<span class="dashboard-sidebar__account-menu-picture dashboard-sidebar__account-menu-initials" aria-hidden="true">{{ user_initials }}</span>
				{% endif %}


				<span class="dashboard-sidebar__account-menu-title">{{ 'Account menu'|t }}</span>
			</button>
			<div id="dashboard-account-menu-content" class="dashboard-sidebar__account-menu-content" hidden>
				<div class="dashboard-sidebar__account-menu-content-inner">
					<div class="dashboard-sidebar__account-menu__account">
						<div class="dashboard-sidebar__account-img">{% if user_picture %}
								<div class="dashboard-sidebar__account-menu-picture" aria-hidden="true">
									{{ user_picture }}
								</div>
							{% else %}
								<span class="dashboard-sidebar__account-menu-picture dashboard-sidebar__account-menu-initials" aria-hidden="true">{{ user_initials }}</span>
							{% endif %}</div>
						<div class="dashboard-sidebar__account-menu__account-info">
							<p class="dashboard-sidebar__account-name text--label">{{ user_name }}</p>
							<p class="dashboard-sidebar__account-email">{{ user_email }}</p>
						</div>
					</div>
					<div class="dashboard-sidebar__account-menu__user-menu">
						<a href="{{ path('user.page') }}" class="dashboard-sidebar__account-menu-profile">
							{{ 'Profile'|t }}
						</a>
					</div>
					<nav class="dashboard-sidebar__account-menu-nav" aria-label="{{ 'Account menu'|t }}">
						{{ page.sidebar_account_menu }}
					</nav>
					<div class="dashboard-sidebar__account-menu__logout">
						<a href="{{ path('user.logout') }}" class="dashboard-sidebar__account-logout">
							{{ 'Log out'|t }}
						</a>
					</div>
				</div>
			</div>
		</div>
	</aside>

	<main id="main-content" class="dashboard-main" tabindex="-1">
		{% include '@soda_scs_manager/cards/soda-scs-manager--create-project-wizard.html.twig' %}
		<div class="dashboard-breadcrumb-and-title">
			{{ page.breadcrumb_and_title }}
		</div>

		{% if page.edit_menu %}
			<div class="drupal-edit-menu">
				{{ page.edit_menu }}
			</div>
		{% endif %}

		<section class="dashboard-content dashboard-content--full">
			{{ page.content }}
		</section>

	</main></div>
