{# Home Hero Header content type. #}
<section{{ attributes.addClass('home-hero-header') }} class="home-hero-header">
  {% set headline = node.field_headline.value ?? '' %}
  {% set introtext = node.field_introtext.value ?? '' %}
  {% set cta_text = node.field_cta_button_text.value ?? '' %}
  {% set cta_link = node.field_cta_button_link.0.url ?? '' %}
  {% set video = node.field_video.entity ?? null %}

  <div class="home-hero-header__content">
    {% if headline %}
      <h1 class="home-hero-header__headline">
        {{ headline }}
      </h1>
    {% endif %}

    {% if introtext %}
      <div class="home-hero-header__introtext">
        <p class="text-bigger">
          {{ introtext }}
        </p>
      </div>
    {% endif %}

    {% if cta_text and cta_link %}
      <a class="home-hero-header__cta btn" href="{{ cta_link }}">
        {{ cta_text }}
      </a>
    {% endif %}
  </div>

  {% if video %}
    <div class="home-hero-header__video">
      {{ content.field_video }}
    </div>
  {% endif %}
</section>
