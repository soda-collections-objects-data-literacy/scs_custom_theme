{# Public shell for the homepage, login, and registration pages. #}
<div class="public-layout">
  <header class="public-header" role="banner">
    <div class="public-header__inner">
      <div class="public-branding">
        {{ page.header_logo }}
      </div>
      {% if page.header_nav %}
        <nav class="public-nav" aria-label="{{ 'Site navigation'|t }}">
          {{ page.header_nav }}
        </nav>
      {% endif %}
      {% if page.header_user_menu %}
        <div class="public-user-menu">
          {{ page.header_user_menu }}
        </div>
      {% endif %}
    </div>
  </header>

  {% if page.edit_menu %}
    <div class="drupal-edit-menu">
      {{ page.edit_menu }}
    </div>
  {% endif %}

  {% if page.highlighted %}
    <div class="public-highlighted">
      {{ page.highlighted }}
    </div>
  {% endif %}

  <main id="main-content" class="public-main content-container" tabindex="-1">
    {{ page.content }}
  </main>

  <footer class="public-footer" role="contentinfo">
    <div class="public-footer__logo">
      {{ page.footer_logo }}
    </div>
    <nav class="public-footer__navs" aria-label="{{ 'Footer navigation'|t }}">
      {{ page.footer_navs }}
    </nav>
  </footer>
</div>
